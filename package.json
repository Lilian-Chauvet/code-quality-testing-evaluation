{
  "name": "code-quality-testing-evaluation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run start --workspace=frontend\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "concurrently": "^8.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.7"
  },
  "lint-staged": {
    "packages/frontend/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "npm run test --workspace=frontend -- --watchAll=false --findRelatedTests"
    ],
    "packages/backend/**/*.js": [
      "eslint --fix",
      "prettier --write",
      "npm test -- --runInBand --findRelatedTests --passWithNoTests"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
